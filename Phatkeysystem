function generateKey() {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const nums = '0123456789';
    
    let key = "Phathackerlo-";
    
    // Tạo 8 số ngẫu nhiên
    for(let i=0; i<8; i++) key += nums.charAt(Math.floor(Math.random() * nums.length));
    key += "-";
    // Tạo 8 chữ ngẫu nhiên
    for(let i=0; i<8; i++) key += chars.charAt(Math.floor(Math.random() * chars.length));
    
    return key;
}

// Khi người dùng bấm nút "Nhận Key":
const myKey = generateKey();
